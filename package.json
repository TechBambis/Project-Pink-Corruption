{
  "name": "bambi-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "repo:check": "node scripts/repo-check.mjs",
    "dev": "tsx apps/server/index.ts",
    "build": "vite build apps/web --outDir ../../dist/web",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "start": "tsx apps/server/index.ts",
    "test:audio": ".runtime/tts-venv/bin/python tests/local_audio_test.py",
    "voice:compare": ".runtime/tts-venv/bin/python tools/voice_lab.py compare",
    "voice:render": ".runtime/tts-venv/bin/python tools/voice_lab.py render",
    "prebuild": "node scripts/prepare-vad.mjs",
    "predev": "node scripts/prepare-vad.mjs",
    "prestart": "node scripts/prepare-vad.mjs",
    "setup": "node scripts/setup-app.mjs",
    "setup:memory": "node scripts/setup-memory.mjs",
    "setup:streaming-speech": "python3 scripts/setup-streaming-speech.py",
    "eval:memory": "tsx scripts/memory-eval.ts",
    "eval:conversation": "tsx scripts/conversation-eval.ts",
    "pretest:navigation": "npm run build",
    "test:navigation": "node scripts/navigation-browser-check.mjs",
    "pretest:model-setup": "npm run build",
    "test:model-setup": "node scripts/model-setup-browser-check.mjs",
    "pretest:integration": "npm run build",
    "test:integration": "node scripts/high-impact-browser-check.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:alpha-build": "node scripts/desktop-alpha-build.mjs",
    "desktop:alpha-check": "node scripts/desktop-alpha-check.mjs",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "desktop:windows-build": "node scripts/desktop-windows-build.mjs",
    "desktop:windows-check": "node scripts/desktop-windows-check.mjs",
    "desktop:windows-ai-check": "node scripts/desktop-windows-ai-check.mjs",
    "desktop:release": "node scripts/desktop-release.mjs",
    "desktop:update": "tsx scripts/desktop-update.ts",
    "pretest:settings": "npm run build",
    "test:settings": "node --import tsx scripts/settings-browser-check.mjs",
    "desktop:macos-build": "node scripts/desktop-macos-build.mjs",
    "desktop:macos-check": "node scripts/desktop-macos-check.mjs",
    "desktop:macos-ai-check": "node scripts/desktop-macos-ai-check.mjs",
    "pretest:profiles": "npm run build",
    "test:profiles": "node --import tsx scripts/profiles-browser-check.mjs",
    "pretest:react-player": "npm run build",
    "test:react-player": "node scripts/react-player-browser-check.mjs",
    "pretest:regie": "npm run build",
    "test:regie": "node scripts/regie-browser-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@ricky0123/vad-web": "0.0.31",
    "@tanstack/react-router": "1.170.44",
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "onnxruntime-web": "1.22.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.4",
    "adm-zip": "0.6.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "playwright": "1.56.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "license": "AGPL-3.0-only"
}
