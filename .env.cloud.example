# Copy to .env.cloud. This optional file is ignored by Git and loaded server-side.
# URL must reach your running inference server, directly or through a private tunnel.
# A tunnel can use http://127.0.0.1:8085; hosted endpoints should use HTTPS.
# BAMBI_CLOUD_URL=http://127.0.0.1:8085
# Use the exact ID returned by the remote /v1/models endpoint.
BAMBI_CLOUD_MODEL=Cydonia-24B-v4.3
BAMBI_CLOUD_API_KEY=
# Optional Salad Container Gateway key; retained only by the local server.
BAMBI_CLOUD_GATEWAY_KEY=
BAMBI_CLOUD_CONTEXT=32768
BAMBI_CLOUD_KIND=llama.cpp
BAMBI_CLOUD_TIMEOUT_MS=300000
BAMBI_CLOUD_DEFAULT=false
# Optional Cydonia sampling overrides. Blank values use the balanced baseline.
BAMBI_CLOUD_TEMPERATURE=
BAMBI_CLOUD_CREATIVE_TEMPERATURE=
BAMBI_CLOUD_TOP_P=
BAMBI_CLOUD_TOP_K=
BAMBI_CLOUD_MIN_P=
BAMBI_CLOUD_REPEAT_PENALTY=
# Optional private bridge; exact native counts with one network trip per count.
# BAMBI_CLOUD_TOKENIZER_URL=http://127.0.0.1:8086
